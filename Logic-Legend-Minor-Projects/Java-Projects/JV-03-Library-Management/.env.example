# Logic Legend JV-03: Library Management System Configuration
# DB_TYPE: 'sqlite' (default zero-config) or 'mysql'
DB_TYPE=sqlite
SQLITE_DB_PATH=data/library.db

# Daily fine rate per overdue day (in INR)
DAILY_FINE_RATE=5.0
DEFAULT_STUDENT_LOAN_DAYS=14
DEFAULT_FACULTY_LOAN_DAYS=30

# MySQL Settings (if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=logic_legend_library
MYSQL_USER=root
MYSQL_PASSWORD=root

