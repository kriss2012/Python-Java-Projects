# Logic Legend JV-04: Online Quiz and Examination Portal Configuration
# Web Server Port
PORT=8084

# DB_TYPE: 'sqlite' (default zero-config) or 'mysql'
DB_TYPE=sqlite
SQLITE_DB_PATH=data/quiz.db

# MySQL Settings (if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=logic_legend_quiz
MYSQL_USER=root
MYSQL_PASSWORD=root

